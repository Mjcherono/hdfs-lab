{
  "title": "Hadoop lab capacity",
  "uid": "hadoop-lab",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "tags": [
    "hadoop",
    "capacity"
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Live DataNodes",
      "description": "Should be 4. Drops during exercise 02.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_num_live_data_nodes",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HDFS capacity HDFS reports",
      "description": "Counts the shared Docker disk once per DataNode, so it overstates real space.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_capacity_total",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "HDFS used (raw, all replicas)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_capacity_used",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "YARN memory in use",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_allocated_mb{queue=\"root\"} / (queue_metrics_allocated_mb{queue=\"root\"} + queue_metrics_available_mb{queue=\"root\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HDFS used vs remaining",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_capacity_used",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_capacity_remaining",
          "legendFormat": "remaining (as reported)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Blocks needing attention",
      "description": "Under-replicated rises when a DataNode stops, then falls as HDFS re-copies.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_low_redundancy_blocks",
          "legendFormat": "under-replicated",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_missing_blocks",
          "legendFormat": "missing",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_corrupt_blocks",
          "legendFormat": "corrupt",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "NameNode objects (files + blocks)",
      "description": "NameNode memory grows with this count, not with bytes stored: the small-files problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_files_total",
          "legendFormat": "files",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "fs_namesystem_blocks_total",
          "legendFormat": "blocks",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "YARN memory: allocated vs available",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_allocated_mb{queue=\"root\"}",
          "legendFormat": "allocated MB",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_available_mb{queue=\"root\"}",
          "legendFormat": "available MB",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "YARN queueing",
      "description": "Waiting containers above zero means jobs are queueing for memory: the saturation signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_pending_containers{queue=\"root\"}",
          "legendFormat": "containers waiting",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_allocated_containers{queue=\"root\"}",
          "legendFormat": "containers running",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "queue_metrics_apps_running{queue=\"root\"}",
          "legendFormat": "apps running",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scrape targets up",
      "description": "1 = Prometheus can read that daemon's metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "up",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
